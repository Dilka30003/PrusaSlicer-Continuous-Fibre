dir_pin = PG3
enable_pin = !PG5
microsteps = 16
rotation_distance = 8
endstop_pin = PG12
position_max = 147
position_min = -5
homing_speed = 40
homing_retract_dist = 2
second_homing_speed = 2
position_endstop = 144.965

[tmc2209 stepper_z]
uart_pin = PC6
run_current = 0.650
stealthchop_threshold = 999999

[extruder]
step_pin = PG4
dir_pin = PC1
enable_pin = !PA2
microsteps = 16
rotation_distance = 15.78
nozzle_diameter = 0.6
filament_diameter = 1.75
pressure_advance = 0.3
heater_pin = PA3
sensor_type = PT1000
sensor_pin = PF4
control = pid
pid_kp = 18.702
pid_ki = 0.826
pid_kd = 105.899
min_extrude_temp = 0
min_temp = 0
max_temp = 310
max_extrude_cross_section = 10

[heater_fan heatbreak_0]
pin = PE5
max_power = 1
shutdown_speed = 1
heater = extruder
heater_temp = 50.0
fan_speed = 1.0

[extruder1]
step_pin = PF9
dir_pin = PF10
enable_pin = !PG2
microsteps = 16
rotation_distance = 15.78
nozzle_diameter = 1
filament_diameter = 1.75
pressure_advance = 0.00
heater_pin = PA0
sensor_type = PT1000
sensor_pin = PF5
control = pid
pid_kp = 21.241
pid_ki = 0.782
pid_kd = 144.175
min_extrude_temp = 0
min_temp = 0
max_temp = 310
max_extrude_cross_section = 10

[heater_fan heatbreak_1]
pin = PD12
max_power = 1
shutdown_speed = 1
heater = extruder1
heater_temp = 50.0
fan_speed = 1.0

[multi_pin part_fan]
pins = PD13, PD14

[fan]
pin = multi_pin:part_fan

[heater_bed]
heater_pin = PB11
sensor_type = Generic 3950
sensor_pin = PF3
control = pid
pid_kp = 56.299
pid_ki = 2.145
pid_kd = 369.459
min_temp = 10
