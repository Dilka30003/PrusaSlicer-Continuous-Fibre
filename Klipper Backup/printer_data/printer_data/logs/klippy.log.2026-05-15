dir_pin = !PF12
enable_pin = !PF14
microsteps = 16
rotation_distance = 32
endstop_pin = tmc2209_stepper_x:virtual_endstop
position_endstop = -28
position_min = -28
position_max = 325
homing_speed = 80
homing_retract_dist = 0

[tmc2209 stepper_x]
uart_pin = PC4
diag_pin = ^PG6
run_current = 0.800
driver_sgthrs = 120
stealthchop_threshold = 999999

[stepper_y]
step_pin = PG0
dir_pin = !PG1
enable_pin = !PF15
microsteps = 16
rotation_distance = 32
endstop_pin = PG13
position_endstop = 0
position_max = 210
homing_speed = 50
homing_retract_dist = 0

[tmc2209 stepper_y]
uart_pin = PD11
run_current = 0.800
stealthchop_threshold = 999999

[stepper_z]
