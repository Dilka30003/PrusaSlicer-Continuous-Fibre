sensor_type = Generic 3950
sensor_pin = PF3
control = pid
pid_kp = 56.299
pid_ki = 2.145
pid_kd = 369.459
min_temp = 10
max_temp = 120

[fan_generic exhaust]
pin = PB0

[multi_pin control_fan]
pins = PA8, PD15

[controller_fan controller_fan]
pin = multi_pin:control_fan
stepper = stepper_x

[servo cutter]
pin = PB6
maximum_servo_angle = 180
initial_angle = 90
