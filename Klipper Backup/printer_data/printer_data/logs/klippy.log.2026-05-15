pid_ki = 0.782
pid_kd = 144.175
min_extrude_temp = 0
min_temp = 0
max_temp = 310
max_extrude_cross_section = 10

[heater_fan heatbreak_1]
pin = PD12
max_power = 1
shutdown_speed = 1
heater = extruder1
heater_temp = 50.0
fan_speed = 1.0

[multi_pin part_fan]
pins = PD13, PD14

[fan]
pin = multi_pin:part_fan

[heater_bed]
heater_pin = PB11
sensor_type = Generic 3950
sensor_pin = PF3
control = pid
pid_kp = 56.299
pid_ki = 2.145
pid_kd = 369.459
min_temp = 10
max_temp = 120

[fan_generic exhaust]
pin = PB0

[multi_pin control_fan]
pins = PA8, PD15

[controller_fan controller_fan]
pin = multi_pin:control_fan
stepper = stepper_x

[servo cutter]
pin = PB6
maximum_servo_angle = 180
initial_angle = 90
