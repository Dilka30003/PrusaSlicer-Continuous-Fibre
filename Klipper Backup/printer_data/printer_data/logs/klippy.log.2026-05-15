position_endstop = 144.935

[tmc2209 stepper_z]
uart_pin = PC6
run_current = 0.650
stealthchop_threshold = 999999

[extruder]
step_pin = PG4
dir_pin = PC1
enable_pin = !PA2
microsteps = 16
rotation_distance = 15.78
nozzle_diameter = 0.6
filament_diameter = 1.75
pressure_advance = 0.3
