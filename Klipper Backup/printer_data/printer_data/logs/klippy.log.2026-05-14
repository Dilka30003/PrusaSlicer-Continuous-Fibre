fan_speed = 1.0

[extruder1]
step_pin = PF9
dir_pin = PF10
enable_pin = !PG2
microsteps = 16
rotation_distance = 15.78
nozzle_diameter = 1
filament_diameter = 1.75
pressure_advance = 0.00
