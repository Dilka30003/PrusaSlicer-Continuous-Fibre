position_max = 147
position_min = -5
homing_speed = 40
homing_retract_dist = 2
second_homing_speed = 2
position_endstop = 144.935

[tmc2209 stepper_z]
uart_pin = PC6
run_current = 0.650
stealthchop_threshold = 999999

[extruder]
