dir_pin = !PG1
enable_pin = !PF15
microsteps = 16
rotation_distance = 32
endstop_pin = PG13
position_endstop = 0
position_max = 210
homing_speed = 50
homing_retract_dist = 0

[tmc2209 stepper_y]
