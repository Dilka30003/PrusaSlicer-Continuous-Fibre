pid_ki = 0.826
pid_kd = 105.899
min_extrude_temp = 0
min_temp = 0
max_temp = 310
max_extrude_cross_section = 10

[heater_fan heatbreak_0]
pin = PE5
max_power = 1
shutdown_speed = 1
heater = extruder
heater_temp = 50.0
fan_speed = 1.0

[extruder1]
step_pin = PF9
dir_pin = PF10
enable_pin = !PG2
microsteps = 16
rotation_distance = 15.78
nozzle_diameter = 1
filament_diameter = 1.75
pressure_advance = 0.00
heater_pin = PA0
sensor_type = PT1000
sensor_pin = PF5
control = pid
